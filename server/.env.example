PORT=5000
NODE_ENV=development
# Number of trusted reverse-proxy hops in production. Keep 0 locally.
TRUST_PROXY_HOPS=0
# Optional; defaults to 90. Schedule cleanup:attendance-photos daily in production.
ATTENDANCE_PHOTO_RETENTION_DAYS=90

# Optional backup location/retention; keep backup storage outside the repository in production.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=workpulse

JWT_SECRET=replace_with_secure_secret

# Comma-separated browser origins allowed by CORS. In production, set only
# approved HTTPS frontend origin(s); localhost defaults are development-only.
FRONTEND_URL=http://localhost:5173
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=WorkPulse <no-reply@example.com>

SUPER_ADMIN_PHONE=your_super_admin_phone
SUPER_ADMIN_EMAIL=your_super_admin_email
SUPER_ADMIN_PASSWORD=replace_with_secure_password
