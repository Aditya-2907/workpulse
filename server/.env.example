# Required production runtime and HTTP configuration
PORT=5000
NODE_ENV=development
# Number of trusted reverse-proxy hops in production. Keep 0 locally.
TRUST_PROXY_HOPS=0

# Required database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=workpulse

# Required: use a unique random value of at least 32 characters in production.
JWT_SECRET=replace_with_secure_secret

# Required: comma-separated browser origins allowed by CORS. In production,
# set only approved HTTPS frontend origin(s); localhost is development-only.
FRONTEND_URL=http://localhost:5173

# Required for authenticated attendance-photo storage and retrieval.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Required when using self-service password reset in production.
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=WorkPulse <no-reply@example.com>

# Optional operational settings. Keep backups outside the repository.
ATTENDANCE_PHOTO_RETENTION_DAYS=90
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

# Optional controlled first-install seed. Prefer the authenticated setup flow;
# never keep these values configured after the first Super Admin exists.
SUPER_ADMIN_PHONE=your_super_admin_phone
SUPER_ADMIN_EMAIL=your_super_admin_email
SUPER_ADMIN_PASSWORD=replace_with_secure_password
